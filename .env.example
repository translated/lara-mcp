# Http
HOST=0.0.0.0
PORT=80
TRANSPORT=http

# Logging
LOGGING_LEVEL=info

# Usage metrics. On by default against the production backend compiled into
# src/metrics.ts; these override it. Either one empty = telemetry off.
# Point them at a local backend, or set DO_NOT_TRACK=1, when developing.
# METRICS_URL=http://localhost:8080
# METRICS_API_KEY=dev-mcp-key

# Where the installation id is kept. Default: ~/.lara
# LARA_HOME=/var/lib/lara

# Opt out of usage metrics entirely (https://consoledonottrack.com).
# DO_NOT_TRACK=1
